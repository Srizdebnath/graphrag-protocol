# LLM (same model across ALL pipelines — hackathon rule)
# Verified to exist via client.models.list(): gemini-2.5-flash, gemini-3.5-flash,
# gemini-3.6-flash, gemini-3.7-flash, gemini-3.8-flash. New 3.x models can
# return 503 UNAVAILABLE under high demand and have small free-tier daily
# quotas (gemini-3.8-flash: 20 req/day). The demo server retries with backoff,
# then optionally tries LLM_FALLBACK_MODEL, then degrades to labeled
# extraction_only (never fabricates).
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Optional second model tried when the primary is overloaded/quota-exhausted.
# gemini-2.5-flash has a much larger free-tier quota — good default.
LLM_FALLBACK_MODEL=

# TigerGraph Cloud (Savanna)
# Copy from Savanna console: Workspace -> Host, and create a Database Secret.
# NEVER put a real secret in this file or any tracked file.
TIGERGRAPH_HOST=
TIGERGRAPH_PORT=443
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_GSQL_SECRET=
TIGERGRAPH_GRAPH_NAME=GraphragProtocol
TIGERGRAPH_USE_SSL=true
TIGERGRAPH_WORKSPACE_ID=

# Neo4j (reference adapter, optional)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me

# Evaluation
BERTSCORE_MODEL=roberta-large
EVAL_OUTPUT_DIR=./hackathon/results

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Demo HTTP server bind address (use 127.0.0.1 for local dev; do NOT expose 0.0.0.0 without auth)
DEMO_HOST=127.0.0.1
DEMO_PORT=8000