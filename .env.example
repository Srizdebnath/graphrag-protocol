# LLM (same model across ALL pipelines — hackathon rule)
# Valid Google model IDs: gemini-2.5-flash (fast), gemini-2.5-pro (complex answers)
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash

# TigerGraph Cloud (Savanna)
# Copy from Savanna console: Workspace -> Host, and create a Database Secret.
# NEVER put a real secret in this file or any tracked file.
TIGERGRAPH_HOST=
TIGERGRAPH_PORT=443
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_GSQL_SECRET=
TIGERGRAPH_GRAPH_NAME=GraphragProtocol
TIGERGRAPH_USE_SSL=true
TIGERGRAPH_WORKSPACE_ID=

# Neo4j (reference adapter, optional)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me

# Evaluation
BERTSCORE_MODEL=roberta-large
EVAL_OUTPUT_DIR=./hackathon/results

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Demo HTTP server bind address (use 127.0.0.1 for local dev; do NOT expose 0.0.0.0 without auth)
DEMO_HOST=127.0.0.1
DEMO_PORT=8000